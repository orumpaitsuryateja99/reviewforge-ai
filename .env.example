POSTGRES_DB=reviewforge
POSTGRES_USER=reviewforge
POSTGRES_PASSWORD=reviewforge
BACKEND_PORT=8080
FRONTEND_PORT=3000
APP_ALLOWED_ORIGINS=http://localhost:3000
BACKEND_INTERNAL_URL=http://backend:8080
REDIS_TIMEOUT=5s

# GitHub App (leave blank to run with the integration disabled)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_API_VERSION=2026-03-10
GITHUB_API_TIMEOUT=2m
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8080/api/v1/auth/github/callback
GITHUB_SETUP_CALLBACK_URL=http://localhost:8080/api/v1/github/installations/callback
FRONTEND_URL=http://localhost:3000
SESSION_COOKIE_SECURE=false

# Review engine (leave GEMINI_API_KEY blank to run with review disabled)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_EFFORT=HIGH
REVIEW_MAX_FILES=12
REVIEW_MIN_CONFIDENCE=0.55

# Background workers
JOB_WORKERS=2
JOB_MAX_ATTEMPTS=3

# Isolated test runner
RUNNER_ENABLED=true
RUNNER_URL=http://runner:8090
RUNNER_RUN_TIMEOUT_SECONDS=300
RUNNER_MAX_SNAPSHOT_BYTES=157286400
RUNNER_MAVEN_OFFLINE=true
